# Root repository tracks only the shared control plane and workspace scripts.
# Every other top-level directory is a separate project by default. This keeps
# newly added or renamed child repositories out of root-level search/context.
/*/
!/.agents/
!/.codex/
!/.context/
!/.github/
!/.workspace/

# Root control-plane repository never tracks packaged child-project artifacts.
/*.zip
/*.7z
/*.rar
/*.tar
/*.tgz

/.context/**/ACTIVE_STATE.md
/.context/**/candidates/
/.context/**/candidate-*.json
/.context/**/history/
/.context/**/runtime/
/.context/**/state.json
/.context/**/*.lock
/.context/project-db-metrics.ts
/ACTIVE_STATE.md
/.workspace/.cache/
/.workspace/canary/
/.workspace/eval/
/.workspace/private/
/.workspace/cache/
/.workspace/logs/
/.workspace/npm-cache/
/.workspace/npm-packages/
/.workspace/npm-releases/
/.workspace/npm-validation/
/.workspace/public-verify-*/
/.workspace/releases/
/.workspace/superseded/
/.workspace/tests/
/.workspace/tools/
/.workspace/web-releases/
/.workspace/relocation-backups/
/.workspace/registry-backups/
/.workspace/embedded-git-backups/
/.workspace/backup-run.lock
/.workspace/Build-ProjectCode-*.ps1
/.workspace/npm-publish-status.json
/.workspace/repository-target.json
/.workspace/state.json
/.wrangler/
*.tmp
.codex-rewind-*
__pycache__/
*.py[cod]

# Credentials and private key material must never enter the control repo.
.env
.env.*
!.env.example
!.env.*.example
*.env
secrets.json
credentials.json
tokens.json
.npmrc
.pypirc
.netrc
id_rsa*
id_ed25519*
*.pem
*.key
*.pfx
*.p12
*.kdbx
*.jks
*.keystore
